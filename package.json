{
  "name": "langtap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run test",
    "build:budget": "next build 2>&1 | npx tsx scripts/check-bundle-budget.ts",
    "performance:smoke": "npx playwright test tests/performance/smoke.spec.ts",
    "performance:trace": "npx playwright test tests/performance/trace.spec.ts",
    "performance": "npx playwright test tests/performance/",
    "lighthouse": "lhci autorun",
    "prebuild": "npm run check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "@vercel/speed-insights": "^2.0.0",
    "motion": "^12.38.0",
    "next": "15.5.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^15",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5",
    "happy-dom": "^20.8.9",
    "jsdom": "^26",
    "prettier": "3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
